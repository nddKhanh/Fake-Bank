# Copy this file to .env before starting PostgreSQL with Docker Compose.
POSTGRES_DB=fake_bank
POSTGRES_USER=fake_bank
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Used when running the Spring Boot application locally.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fake_bank
DB_USERNAME=fake_bank
DB_PASSWORD=change-me
SERVER_PORT=8081

# Optional wallet database scaffold (Docker Compose profile: wallet).
# Ops Console currently starts without PostgreSQL; backend logic is TODO.
WALLET_DB_HOST=localhost
WALLET_DB_PORT=5433
WALLET_DB_NAME=wallet
WALLET_DB_USERNAME=wallet
WALLET_DB_PASSWORD=wallet-local
WALLET_PORT=8080
BANK_URL=http://localhost:8081
OPS_DB_USERNAME=ops_reader
OPS_DB_PASSWORD=replace-after-creating-ops-reader
